---
import { profile } from '../data/profile'
import { siteMetadata } from '../lib/metadata'
import '../styles/global.css'

const iconMarkup = {
  terminal:
    '<polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line>',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path>',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle>',
  instagram:
    '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>',
  x: '<path d="M4 4l16 16"></path><path d="M20 4L4 20"></path>',
}

const externalArrow = '<path d="M7 17L17 7"></path><path d="M8 7h9v9"></path>'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: siteMetadata.url,
  sameAs: profile.links.map((link) => link.href),
  jobTitle: profile.title,
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteMetadata.title}</title>
    <meta name="description" content={siteMetadata.description} />
    <link rel="canonical" href={siteMetadata.url} />
    <link rel="icon" href="/logo/black.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/logo/white.svg" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={siteMetadata.themeColor} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={siteMetadata.title} />
    <meta property="og:description" content={siteMetadata.description} />
    <meta property="og:url" content={siteMetadata.url} />
    <meta property="og:image" content={`${siteMetadata.url}${siteMetadata.image}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteMetadata.title} />
    <meta name="twitter:description" content={siteMetadata.description} />
    <meta name="twitter:image" content={`${siteMetadata.url}${siteMetadata.image}`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <main class="page-shell">
      <section class="profile-card" aria-labelledby="profile-title">
        <a
          class="identity-mark"
          href="https://ranimontagna.com"
          aria-label="Abrir site de Ranielli Montagna"
        >
          <span class="portrait-frame">
            <img
              src="/images/ranielli-montagna.webp"
              alt="Retrato de Ranielli Montagna"
              width="136"
              height="136"
              decoding="async"
              fetchpriority="high"
            />
          </span>
          <span class="brand-badge" aria-hidden="true">
            <img src="/logo/white.svg" alt="" width="44" height="44" />
          </span>
        </a>

        <div class="profile-copy">
          <p class="handle">{profile.handle}</p>
          <h1 id="profile-title">{profile.title}</h1>
          <p class="subtitle">{profile.subtitle}</p>
        </div>

        <nav class="links-list" aria-label="Links principais">
          {
            profile.links.map((link, index) => (
              <a
                class="link-button"
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.ariaLabel}
                style={`--index: ${index}`}
              >
                <span class="link-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={iconMarkup[link.icon]} />
                </span>
                <span class="link-label">{link.label}</span>
                <span class="link-icon link-icon--right" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={externalArrow} />
                </span>
              </a>
            ))
          }
        </nav>

        <footer class="footer-note">
          <span>{profile.name}</span>
          <span>links.ranimontagna.com</span>
        </footer>
      </section>
    </main>
  </body>
</html>
